    "claude-code": {
      "channel": "stable",
      "install_method": "verified-vendor-script",
      "launcher": "cl",
      "installer_url": "https://claude.ai/install.sh",
      "installer_sha256": "cde4f1702d3b1695f92b73d26888364e17bca476e17f0fd676484c951d36c125"
    },
    "grok-build": {
      "channel": "stable",
      "install_method": "verified-vendor-script",
      "launcher": "gk",
      "installer_url": "https://x.ai/cli/install.sh",
      "installer_sha256": "43d0943123edade1383a476a4f778674877acee7c1f98a00f094c4a0f7349321"
    },
    "detection": {
      "_doc": "Where each active harness must resolve on an installed device, so the one-owner-per-harness policy is checkable instead of prose. `enforcement: owned-prefix` means this repository installs the harness and a resolution outside `owned_prefix_default` is drift -- normally a second copy from a package-manager global shadowing the managed one. `enforcement: observe-only` means the vendor's own installer chooses the target: the path is recorded so drift is visible, but this repository does not own it and will not fail on it.",
      "codex": {
        "command": "codex",
        "enforcement": "owned-prefix",
        "owned_prefix_default": "${HOME}/.local/share/rldyour/npm",
        "owned_prefix_env": "RLDYOUR_CODEX_NPM_PREFIX",
        "owner": "rldyour::install_vendor_ai_clis",
        "rationale": "Installed from the verified npm tarball into a prefix this repository chooses, then linked as ~/.local/bin/codex. A codex resolving anywhere else means another installer won."
      },
      "claude-code": {
        "command": "claude",
        "enforcement": "observe-only",
        "owned_prefix_default": "${HOME}/.local/share/claude",
        "owned_prefix_env": "RLDYOUR_CLAUDE_HOME",
        "owner": "vendor installer https://claude.ai/install.sh",
        "rationale": "The reviewed vendor script picks its own target and may change it between releases. Recording where claude resolves is evidence; enforcing a path this repository does not choose would fail on a correct install."
      },
      "grok-build": {
        "command": "grok",
        "enforcement": "observe-only",
        "owned_prefix_default": "${HOME}/.grok",
        "owned_prefix_env": "RLDYOUR_GROK_HOME",
        "owner": "vendor installer https://x.ai/cli/install.sh",
        "rationale": "Same boundary as claude-code: the vendor installer owns the target."
      }
    }
  },
